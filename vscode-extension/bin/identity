#!/usr/bin/env bash
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 1. Check if identity exists in PATH outside this shim directory
which -a identity 2>/dev/null | while read -r line; do
    if [ "$(dirname "$line")" != "$SELF_DIR" ]; then
        exec "$line" "$@"
    fi
done

# 2. Check bundled python directory inside extension, repository src, or alt paths
if [ -d "$SELF_DIR/../python/identity_cli" ]; then
    export PYTHONPATH="$SELF_DIR/../python:$PYTHONPATH"
elif [ -d "$SELF_DIR/../../src/identity_cli" ]; then
    export PYTHONPATH="$SELF_DIR/../../src:$PYTHONPATH"
elif [ -d "$SELF_DIR/../src/identity_cli" ]; then
    export PYTHONPATH="$SELF_DIR/../src:$PYTHONPATH"
fi

# 3. Try running via python3 / python
if command -v python3 &>/dev/null; then
    if ! python3 -c "import faker, openpyxl, rich, typer" &>/dev/null; then
        echo "[Identity Generator] First-time setup: installing required dependencies: faker, openpyxl, rich, typer..."
        echo "[Identity Generator] Please wait while packages are installed via pip..."
        python3 -m pip install --user faker openpyxl rich typer
    fi
    exec python3 -m identity_cli.cli "$@"
fi

if command -v python &>/dev/null; then
    if ! python -c "import faker, openpyxl, rich, typer" &>/dev/null; then
        echo "[Identity Generator] First-time setup: installing required dependencies: faker, openpyxl, rich, typer..."
        echo "[Identity Generator] Please wait while packages are installed via pip..."
        python -m pip install --user faker openpyxl rich typer
    fi
    exec python -m identity_cli.cli "$@"
fi

echo "[Identity Generator] Error: Neither python3 nor identity executable was found." >&2
echo "Please ensure Python 3.8+ is installed on your system." >&2
exit 1
